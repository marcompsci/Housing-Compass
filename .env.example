# ─── Client (bundled into the app — PUBLIC values only) ───────────────────────
# Fictional demo listings on/off. Leave "true" until real verified inventory exists (Phase 4).
EXPO_PUBLIC_DEMO_MODE=true
# MapLibre style URL. Default is OpenFreeMap (free, no key, OSM attribution required).
# For production traffic use a licensed provider (MapTiler, Stadia, Protomaps self-hosted, …).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Supabase project (Phase 3). The anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional fixed clock for screenshots / e2e (ISO 8601). Leave empty in real use.
EXPO_PUBLIC_FIXED_NOW=

# ─── Server only (Supabase Edge Function secrets — NEVER prefix with EXPO_PUBLIC_) ─
# SUPABASE_SERVICE_ROLE_KEY=        # set with `supabase secrets set`, never commit
# NOTIFY_EXPO_ACCESS_TOKEN=         # Phase 6 push notifications
# TRANSIT_511_API_TOKEN=            # Phase 4+ transit times (511.org open data token)
# DOORWAY_DATA_AGREEMENT_REF=       # only after BAHFA/MTC grant written authorization
